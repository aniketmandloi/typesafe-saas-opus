{
  "name": "typesafe-saas-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node scripts/assert-node-linker.ts",
    "check:graph": "node scripts/check-graph.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "generate:env": "node scripts/generate-env.ts",
    "check:env": "node scripts/generate-env.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node apps/server/src/entrypoints/migrate.ts",
    "e2e": "pnpm --filter @repo/e2e e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@repo/env": "workspace:*",
    "@repo/profiles": "workspace:*",
    "@types/node": "^24.13.6",
    "drizzle-kit": "0.31.10",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
